FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S fund && adduser -S -G fund fund
RUN mkdir -p /data/ta-exports && chown fund:fund /data/ta-exports
COPY --chown=fund:fund app.jar /app/app.jar
USER fund
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/actuator/health || exit 1
ENTRYPOINT ["java","-jar","/app/app.jar"]
