# Linux Docker Compose deployment only. Copy to .env and replace all placeholders.
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
APP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
WEB_PORT=80
# Set true when serving through HTTPS; local HTTP needs false.
COOKIE_SECURE=false
# Use a unique name per project; __Host- names require HTTPS, Secure=true and no Domain.
SESSION_COOKIE_NAME=SESSION
# FRAMEWORK only behind the trusted gateway; keep NONE for direct HTTP access.
FORWARD_HEADERS_STRATEGY=NONE
